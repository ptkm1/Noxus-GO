{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.12.0",
      "pnpm": "10.22.0",
      "env": {
        "EXPO_USE_LOCAL_CLI": "1"
      },
      "android": {
        "buildType": "apk",
        "config": "development-android.yml"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.12.0",
      "pnpm": "10.22.0",
      "env": {
        "EXPO_USE_LOCAL_CLI": "1",
        "EXPO_PUBLIC_API_URL": "https://noxus-go.onrender.com"
      },
      "android": {
        "buildType": "apk",
        "config": "preview-android.yml"
      },
      "ios": {
        "simulator": false,
        "config": "preview-ios.yml"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.12.0",
      "pnpm": "10.22.0",
      "env": {
        "EXPO_USE_LOCAL_CLI": "1",
        "EXPO_PUBLIC_API_URL": "https://noxus-go.onrender.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
