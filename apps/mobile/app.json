{
  "expo": {
    "name": "commerce pro mobile",
    "slug": "pedidos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pedidos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8A3FFC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedidos.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8A3FFC"
      },
      "package": "com.pedidos.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmara só para ler códigos de barras ao registar vendas.",
          "microphonePermission": "Opcional para vídeo; não é necessário para vendas rápidas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O commerce pro mobile usa a sua localização em segundo plano para o gestor acompanhar a rota da equipa (uso profissional).",
          "locationWhenInUsePermission": "O commerce pro mobile usa a sua localização para o mapa de rota, check-in de visitas e rastreio.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager"
    ]
  }
}
