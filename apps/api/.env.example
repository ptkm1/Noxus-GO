DATABASE_URL=postgresql://pedidos:pedidos@localhost:5432/pedidos
# Produção Neon: URL direta (sem -pooler) para migrate. Se omitir, o prisma.config remove -pooler sozinho.
# DIRECT_URL=

JWT_SECRET=gere-uma-string-longa-aleatoria-minimo-16-chars
JWT_REFRESH_SECRET=outra-string-longa-diferente-da-anterior

API_PORT=4000
API_HOST=0.0.0.0

# Google Routes API (rota por estrada no servidor — não commitar chave real)
# Ative "Routes API" no Google Cloud. Pode ser a mesma chave do Maps ou uma só de backend.
# GOOGLE_MAPS_SERVER_API_KEY=

# Interruptor mestre: false = nunca chama routes.googleapis.com (seguro em dev)
GOOGLE_ROUTES_ENABLED=false
# Máximo de pedidos Routes por organização por dia UTC (0 = bloqueado mesmo com ENABLED=true)
GOOGLE_ROUTES_DAILY_MAX_PER_ORG=0
# Teto global opcional por dia (0 = sem limite global extra)
GOOGLE_ROUTES_DAILY_MAX_GLOBAL=0
# Exemplo produção (quando tiver orçamento):
# GOOGLE_ROUTES_ENABLED=true
# GOOGLE_ROUTES_DAILY_MAX_PER_ORG=100
# GOOGLE_ROUTES_DAILY_MAX_GLOBAL=500

# --- E-mail transacional (opcional) ---
# Recomendado: Resend (https://resend.com) — API simples, bom free tier.
# Basta definir RESEND_API_KEY + EMAIL_FROM (domínio verificado no painel).
#
# Alternativa: SendGrid — use EMAIL_PROVIDER=sendgrid e SENDGRID_API_KEY.
#
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# SENDGRID_API_KEY=
# EMAIL_FROM=PedixPro <noreply@seudominio.com>
#
# Links de ativação / reset usam o painel (TTL: ativação 48h, reset 1h).
# WEB_APP_ORIGIN=https://app.pedixpro.com.br
# WEB_PUBLIC_URL=https://app.pedixpro.com.br
# SITE_PUBLIC_URL=https://pedixpro.com.br
# Aliases aceitos pela contratação Asaas:
# PEDIXPRO_APP_URL=https://app.pedixpro.com.br
# PEDIXPRO_LANDING_URL=https://pedixpro.com.br

# --- Asaas (checkout recorrente / webhooks) ---
# Sandbox: https://sandbox.asaas.com — produção: https://www.asaas.com
# Gateway: auto (Asaas se houver API key; senão trial local) | asaas | fake
# PAYMENT_GATEWAY=auto
# Local: cadastro sem paywall. Nunca use em produção (é ignorado se NODE_ENV=production).
# DEV_SKIP_PAYMENT_LOCK=1
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENVIRONMENT=sandbox
# ASAAS_CHECKOUT_URL_PREFIX=https://sandbox.asaas.com/checkoutSession/show
# SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# --- Web Push (VAPID) — grátis; gerar com: npx web-push generate-vapid-keys ---
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:admin@seudominio.com

# --- Jobs internos (cron) ---
# Protege POST /api/v1/jobs/stock-expiry (Authorization: Bearer … ou x-cron-secret).
# CRON_SECRET=gere-uma-string-longa-aleatoria
# Agenda diária na API (08:00): STOCK_EXPIRY_CRON=1
# STOCK_EXPIRY_CRON=0
# STOCK_EXPIRY_CRON_TZ=America/Sao_Paulo
# Fila de transmissão NF-e (poll/retry a cada 1 min): FISCAL_TRANSMIT_CRON=1
# FISCAL_TRANSMIT_CRON=0

# --- Consulta CNPJ (Receita Federal via proxy) ---
# Provedor: brasilapi (gratuito, padrão) ou serpro (API oficial contratada).
# CNPJ_PROVIDER=brasilapi
#
# Serpro — após contratar em https://apicenter.estaleiro.serpro.gov.br/documentacao/consulta-cnpj/
# SERPRO_CONSUMER_KEY=
# SERPRO_CONSUMER_SECRET=

# Chave para criptografar certificado A1 em repouso (mín. 16 caracteres)
# FISCAL_ENCRYPTION_KEY=gere-uma-string-longa-aleatoria-minimo-16-chars
