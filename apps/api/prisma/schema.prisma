generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  SUPERVISOR
  MANAGER
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  PENDING_CREDIT_APPROVAL
}

enum CreditPolicy {
  WARN_ONLY
  BLOCK_ORDER
  REQUIRE_APPROVAL
}

enum CreditTitleStatus {
  OPEN
  PAID
  CANCELLED
}

/// Quem pode usufruir da promoção neste produto.
enum PromotionScope {
  PRODUCT_GLOBAL
  SELLER
  CUSTOMER
}

/// Como o valor altera o preço de catálogo (tabela/base).
enum PromotionKind {
  PERCENT_OFF
  FIXED_AMOUNT_OFF
  SALE_PRICE
}

/// Desconto aplicado quando o carrinho forma um combo completo (prioridade configurável).
enum ProductComboDiscountKind {
  FIXED_PER_COMPLETE_SET
  PERCENT_OF_SET_SUBTOTAL
}

/// Como o vendedor é comissionado (define de onde vem o % na venda).
enum SellerCommissionType {
  FIXED
  BY_PRODUCT
  BY_CATEGORY
  BY_SUPPLIER
}

enum CustomerDocumentType {
  CNPJ
  CPF
}

/// Classificação comercial do produto (cadastro).
enum ProductClassification {
  RESALE
  RAW_MATERIAL
  INTERNAL_USE
  SERVICE
  OTHER
}

enum StockMovementType {
  MANUAL_IN
  MANUAL_OUT
  ADJUST
  SALE
  SALE_REVERSAL
}

enum AccountsPayableStatus {
  AUTHORIZED
  PENDING
  PAID
  CANCELLED
}

/// Nível de acesso na matriz de roles (org-scoped).
enum AccessLevel {
  none
  read
  write
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  /// Nome amigável para UI / whitelabel (fallback: `name`).
  displayName      String?
  logoUrl          String?
  /// Cor principal da marca (hex, ex.: #0284c7) para tema futuro no app.
  primaryColor     String?
  /// Identificador opcional para futuro subdomínio (único global quando preenchido).
  slug             String?            @unique
  /// Política quando cliente está bloqueado, com limite estourado ou títulos vencidos.
  creditPolicy     CreditPolicy       @default(WARN_ONLY)
  /// Desconto máximo extra do vendedor (%) quando o produto não define `maxSellerDiscountPercent`.
  defaultMaxSellerDiscountPercent Decimal @default(50) @db.Decimal(5, 2)
  /// TODO futuro: CNPJ do emitente para NF-e real / certificado.
  cnpj             String?
  /// TODO futuro: Inscrição estadual do emitente.
  stateRegistration String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  sellers          Seller[]
  regions          Region[]
  priceTables      PriceTable[]
  products         Product[]
  productCategories ProductCategory[]
  productPromotions ProductPromotion[]
  productCombos    ProductCombo[]
  sellerCommissionRules SellerCommissionRule[]
  commissionProgressiveTiers CommissionProgressiveTier[]
  sellerMonthlyGoals SellerMonthlyGoal[]
  customers        Customer[]
  orders           Order[]
  customerCreditTitles CustomerCreditTitle[]
  sellerCustomerVisits SellerCustomerVisit[]
  sellerLiveLocations  SellerLiveLocation[]
  sellerLocationHistory SellerLocationHistory[]
  salesTeams         SalesTeam[]
  suppliers          Supplier[]
  productLots        ProductLot[]
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  costCenters        CostCenter[]
  expenseHistories   ExpenseHistory[]
  fixedExpenses      OperationalFixedExpense[]
  accountsPayables   AccountsPayable[]
  rolePermissions    OrganizationRolePermission[]
}

/// Matriz de permissões por organização (defaults seedados; ADMIN edita via painel).
model OrganizationRolePermission {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  /// Chave estável alinhada a PermissionResource (ex.: stock, orders).
  resource       String
  level          AccessLevel
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, role, resource])
  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  /// Matrícula funcional (única por organização quando preenchida).
  matricula      String?
  role           Role
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seller         Seller?
  managedSellers Seller[]     @relation("SellerManager")
  notifications  Notification[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, matricula])
}

model Seller {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerUserId     String?
  manager           User?              @relation("SellerManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  commissionType    SellerCommissionType @default(FIXED)
  commissionPercent Decimal            @db.Decimal(5, 2)
  active            Boolean            @default(true)
  sellerProducts    SellerProduct[]
  productPromotions ProductPromotion[]
  priceTables       PriceTable[]
  commissionRules   SellerCommissionRule[]
  commissionProgressiveTiers CommissionProgressiveTier[]
  monthlyGoals      SellerMonthlyGoal[]
  orders            Order[]
  customers         Customer[]
  sellerCustomerVisits SellerCustomerVisit[]
  liveLocation         SellerLiveLocation?
  locationHistory      SellerLocationHistory[]
  teamId               String?
  team                 SalesTeam?         @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeam              SalesTeam?         @relation("TeamLeader")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizationId, managerUserId])
  @@index([organizationId, teamId])
}

model SalesTeam {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaderSellerId String       @unique
  leaderSeller   Seller       @relation("TeamLeader", fields: [leaderSellerId], references: [id], onDelete: Restrict)
  members        Seller[]     @relation("TeamMembers")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// Última posição reportada pelo app do vendedor (foreground).
model SellerLiveLocation {
  sellerId         String       @id
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  latitude         Decimal      @db.Decimal(10, 8)
  longitude        Decimal      @db.Decimal(11, 8)
  accuracyMeters   Float?
  recordedAt       DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, recordedAt])
}

/// Pontos de trajeto (amostrados) para replay no mapa admin.
model SellerLocationHistory {
  id               String       @id @default(cuid())
  sellerId         String
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  latitude         Decimal      @db.Decimal(10, 8)
  longitude        Decimal      @db.Decimal(11, 8)
  accuracyMeters   Float?
  recordedAt       DateTime     @default(now())

  @@index([sellerId, recordedAt])
  @@index([organizationId, recordedAt])
}

model Region {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  customers      Customer[]
  priceTables    PriceTable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

model PriceTable {
  id             String           @id @default(cuid())
  name           String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  validFrom      DateTime?
  validTo        DateTime?
  /// Maior prioridade escolhe entre tabelas igualmente aplicáveis (mesma especificidade).
  priority       Int              @default(0)
  /// Escopo opcional: todos os filtros não-nulos devem coincidir com o contexto da venda.
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerId       String?
  seller         Seller?          @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  regionId       String?
  region         Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)
  items          PriceTableItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

/// Categoria de produto por organização (valores estáveis em `code`, como um enum persistido).
model ProductCategory {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String
  /// JSON: lista de definições de campos dinâmicos (tipo PIM por categoria).
  attributeSchema  Json?
  /// % de comissão quando vendedores usam modo BY_CATEGORY.
  commissionPercent Decimal?          @db.Decimal(5, 2)
  products         Product[]
  commissionRules  SellerCommissionRule[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, code])
  @@map("product_categories")
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  legalName      String
  cnpj           String
  tradeName      String
  active         Boolean      @default(true)
  products       Product[]
  fixedExpenses  OperationalFixedExpense[]
  accountsPayables AccountsPayable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, cnpj])
  @@index([organizationId])
}

model Product {
  id               String             @id @default(cuid())
  name             String
  sku              String?
  /// Código de barras / EAN para leitura na venda rápida.
  barcode          String?
  description      String?
  /// URL pública da foto (CDN, bucket, etc.) para catálogo no app do vendedor.
  imageUrl         String?
  basePrice        Decimal            @db.Decimal(12, 2)
  /// Limite extra do vendedor sobre preço já promocional (null = usa limite da organização).
  maxSellerDiscountPercent Decimal?    @db.Decimal(5, 2)
  /// Piso por unidade após promoções e desconto do vendedor (null = sem piso específico).
  minSaleUnitPrice Decimal?           @db.Decimal(12, 2)
  /// % de comissão quando vendedores usam modo BY_PRODUCT.
  commissionPercent Decimal?           @db.Decimal(5, 2)
  /// JSON: valores dos campos definidos em `category.attributeSchema`.
  attributes       Json               @default("{}")
  /// Quantidade em estoque (unidades vendáveis).
  stockQty         Int                @default(0)
  /// Se ativo, impede venda quando `stockQty` é insuficiente.
  blockSaleWhenOutOfStock Boolean       @default(false)
  /// Linha comercial (ex.: Linha 1).
  productLine      String?
  productClassification ProductClassification?
  /// Unidade de compra (UN, CX, FD…).
  purchaseUnit     String?
  /// Quantidade por caixa padrão na compra.
  standardPurchaseBoxQty Int?
  grossWeightKg    Decimal?             @db.Decimal(10, 3)
  netWeightKg      Decimal?             @db.Decimal(10, 3)
  stockAddress     String?
  minStockQty      Int                  @default(0)
  maxStockQty      Int?
  costPrice        Decimal?             @db.Decimal(12, 2)
  factoryPrice     Decimal?             @db.Decimal(12, 2)
  maxSalePrice     Decimal?             @db.Decimal(12, 2)
  freightAmount    Decimal?             @db.Decimal(12, 2)
  collectionCommissionPercent Decimal?  @db.Decimal(5, 2)
  maxDailyQtyPerSeller Int?
  maxDailyQtyPerCustomer Int?
  ncm              String?
  ncmException     String?
  /// Origem da mercadoria na NF-e (0–8).
  nfeOrigin        Int?
  fiscalClass      String?
  pisCofinsClassification String?
  cstPis           String?
  ipiPercent       Decimal?             @db.Decimal(5, 2)
  icmsCostPercent  Decimal?           @db.Decimal(5, 2)
  cbsIbsClassification String?
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  priceTableItems  PriceTableItem[]
  sellerProducts   SellerProduct[]
  promotions       ProductPromotion[]
  comboLines       ProductComboLine[]
  commissionRules  SellerCommissionRule[]
  orderItems       OrderItem[]
  lots             ProductLot[]
  stockMovements   StockMovement[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([organizationId, barcode])
  @@index([organizationId, supplierId])
  @@index([organizationId, categoryId])
  @@index([organizationId, ncm])
}

/// Lote de produto com validade e saldo próprio.
model ProductLot {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotCode        String
  expiresAt      DateTime
  qty            Int            @default(0)
  movements      StockMovement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([productId, lotCode])
  @@index([organizationId, expiresAt])
  @@index([productId, expiresAt])
}

/// Ledger de movimentações de estoque.
model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           StockMovementType
  qtyDelta       Int
  balanceAfter   Int
  lotId          String?
  lot            ProductLot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)
  lotCode        String?
  expiresAt      DateTime?
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([orderId])
}

/// Histórico rastreável de alterações sensíveis.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userMatricula  String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model ProductPromotion {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  scope          PromotionScope
  sellerId       String?
  seller         Seller?         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind           PromotionKind
  /// PERCENT_OFF: 0–100 | FIXED_AMOUNT_OFF: R$ por unidade | SALE_PRICE: preço final por unidade.
  value          Decimal         @db.Decimal(12, 2)
  /// Se definido, a promo só concorre quando `quantity >= minQuantity` na linha.
  minQuantity    Int?
  label          String?
  active         Boolean         @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  priority       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, productId])
  @@map("product_promotions")
}

model ProductCombo {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  label          String?
  active         Boolean                  @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  priority       Int                      @default(0)
  kind           ProductComboDiscountKind
  /// FIXED_PER_COMPLETE_SET: R$ por cada conjunto completo | PERCENT_OF_SET_SUBTOTAL: % sobre subtotal do conjunto.
  value          Decimal                  @db.Decimal(12, 2)
  lines          ProductComboLine[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId])
}

model ProductComboLine {
  id        String       @id @default(cuid())
  comboId   String
  combo     ProductCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([comboId, productId])
}

model SellerCommissionRule {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId           String
  seller             Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  commissionPercent  Decimal          @db.Decimal(5, 2)
  priority           Int              @default(0)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, sellerId])
}

/// Faixa de comissão progressiva pelo faturamento confirmado no mês (MTD).
model CommissionProgressiveTier {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Null = faixa global da organização (vale para todos os vendedores sem faixas próprias).
  sellerId           String?
  seller             Seller?      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// Vendas confirmadas no mês (R$) desde as quais esta faixa se aplica (inclusive).
  thresholdAmount    Decimal      @db.Decimal(14, 2)
  commissionPercent  Decimal      @db.Decimal(5, 2)
  label              String?
  priority           Int          @default(0)
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, sellerId])
}

/// Meta de faturamento por vendedor e mês civil.
model SellerMonthlyGoal {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  title            String       @default("Meta do mês")
  targetAmount     Decimal      @db.Decimal(14, 2)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, sellerId, year, month])
}

model PriceTableItem {
  id           String     @id @default(cuid())
  priceTableId String
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  price        Decimal    @db.Decimal(12, 2)

  @@unique([priceTableId, productId])
}

model SellerProduct {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sellerId, productId])
}

model Customer {
  id             String             @id @default(cuid())
  name           String
  email          String?
  phone          String?
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId       String?
  seller         Seller?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  regionId       String?
  region         Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  /// Limite de crédito (saldo em aberto máximo). Null = sem limite configurado.
  creditLimit    Decimal?           @db.Decimal(14, 2)
  /// Bloqueio manual — não permite novo pedido confirmado (conforme política da organização).
  creditBlocked  Boolean            @default(false)
  promotions     ProductPromotion[]
  priceTables    PriceTable[]
  orders         Order[]
  creditTitles   CustomerCreditTitle[]
  sellerCustomerVisits SellerCustomerVisit[]
  /// Coordenadas para mapa / rota (opcional; configuradas pelo admin).
  latitude       Decimal?           @db.Decimal(10, 8)
  longitude      Decimal?           @db.Decimal(11, 8)
  addressNote    String?
  documentType   CustomerDocumentType?
  cnpj           String?
  cpf            String?
  legalName      String?
  tradeName      String?
  cep            String?
  street         String?
  number         String?
  neighborhood   String?
  state          String?
  city           String?
  cityIbgeCode   String?
  stateRegistration String?
  buyerName      String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, cnpj])
  @@unique([organizationId, cpf])
  @@index([organizationId, state, city])
}

model CustomerCreditTitle {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reference        String?
  amount           Decimal           @db.Decimal(14, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(14, 2)
  issueDate        DateTime          @default(now())
  dueDate          DateTime
  status           CreditTitleStatus @default(OPEN)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, customerId])
}

model SellerCustomerVisit {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  checkedInAt      DateTime     @default(now())
  checkedOutAt     DateTime?
  checkInLat       Decimal?     @db.Decimal(10, 8)
  checkInLng       Decimal?     @db.Decimal(11, 8)
  checkOutLat      Decimal?     @db.Decimal(10, 8)
  checkOutLng      Decimal?     @db.Decimal(11, 8)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([sellerId, checkedInAt])
  @@index([organizationId, checkedInAt])
}

model Order {
  id             String       @id @default(cuid())
  status         OrderStatus  @default(DRAFT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalAmount    Decimal      @db.Decimal(14, 2)
  /// Total descontado por combos aplicados sobre as linhas (já refletido em `totalAmount`).
  comboDiscountTotal Decimal   @default(0) @db.Decimal(14, 2)
  notes          String?
  /// UUID gerado no cliente para vendas offline — replay idempotente (sem duplicar pedido).
  clientMutationId String? @unique
  /// Motivos registrados quando o pedido ficou aguardando aprovação de crédito.
  creditHoldReasons Json?
  /// TODO futuro: número sequencial por org para filtro "Número entre" (hoje id=cuid). Pode ser removido ou implementado depois.
  orderNumber    Int?
  /// TODO futuro: flag de orçamento vs pedido real. Reservado; UI não filtra neste ciclo.
  isQuote        Boolean      @default(false)
  /// TODO futuro: "Representada" (multi-empresa). Reservado; UI não filtra neste ciclo.
  representada   String?
  items          OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  productName String
  commissionPercent Decimal? @db.Decimal(5, 2)
  commissionAmount  Decimal? @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean   @default(false)
  createdAt DateTime @default(now())
}

/// Centro de custo (lookup para lançamentos / despesas fixas).
model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  active         Boolean      @default(true)
  fixedExpenses  OperationalFixedExpense[]
  accountsPayables AccountsPayable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Histórico contábil / natureza da despesa (ex.: IMPOSTO).
model ExpenseHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  description    String
  active         Boolean      @default(true)
  fixedExpenses  OperationalFixedExpense[]
  accountsPayables AccountsPayable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Template de despesa operacional fixa (recorrente) para uso futuro em relatórios.
model OperationalFixedExpense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  historyId      String?
  history        ExpenseHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)
  amount         Decimal      @db.Decimal(14, 2)
  /// Dia do mês do vencimento recorrente (1–28).
  dayOfMonth     Int
  active         Boolean      @default(true)
  notes          String?
  competenceLabel String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active])
}

/// Lançamento de contas a pagar (despesa operacional).
model AccountsPayable {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Número / referência do documento.
  docNumber      String
  supplierId     String
  supplier       Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  issueDate      DateTime
  dueDate        DateTime
  /// Competência (usar 1º dia do mês).
  competence     DateTime
  historyId      String?
  history        ExpenseHistory?       @relation(fields: [historyId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  amount         Decimal               @db.Decimal(14, 2)
  notes          String?
  status         AccountsPayableStatus @default(AUTHORIZED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
}
