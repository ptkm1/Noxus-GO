# Produção — copie para o painel Render (serviço Nexus-GO).
# Não commitar valores secretos. DATABASE_URL vem do Neon (connection string pooled).

NODE_ENV=production
API_HOST=0.0.0.0
# Render injeta PORT; o start command já faz API_PORT=$PORT

# Neon Postgres (use a URL pooled do branch production)
DATABASE_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=

WEB_PUBLIC_URL=https://app.pedixpro.com.br
WEB_APP_ORIGIN=https://app.pedixpro.com.br
PEDIXPRO_APP_URL=https://app.pedixpro.com.br
SITE_PUBLIC_URL=https://pedixpro.com.br
PEDIXPRO_LANDING_URL=https://pedixpro.com.br

# Webhook Asaas: https://api.pedixpro.com.br/api/v1/webhooks/asaas
PAYMENT_GATEWAY=asaas
ASAAS_ENVIRONMENT=production
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_CHECKOUT_URL_PREFIX=https://www.asaas.com/checkoutSession/show
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=PedixPro <noreply@pedixpro.com.br>

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:suporte@pedixpro.com.br

FISCAL_ENCRYPTION_KEY=
CRON_SECRET=
STOCK_EXPIRY_CRON=1
STOCK_EXPIRY_CRON_TZ=America/Sao_Paulo
FISCAL_TRANSMIT_CRON=1

GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_DAILY_MAX_PER_ORG=0
GOOGLE_ROUTES_DAILY_MAX_GLOBAL=0
# GOOGLE_MAPS_SERVER_API_KEY=
