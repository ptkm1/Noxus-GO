# Frontends e referência Docker.
# Copia também apps/api/.env.example → apps/api/.env e preenche DATABASE_URL, JWT_*, API_*.

# PostgreSQL (referência; docker-compose.yml usa estes valores em environment)
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos
POSTGRES_DB=pedidos

# Web (Vite) — só origem, sem /api. Local: http://localhost:4000 | Túnel: https://xxxx.ngrok-free.app
VITE_API_URL=http://localhost:4000
# Produção (Vercel apps/web): VITE_API_URL=https://sua-api.onrender.com
# Mapa do painel (rastreio) — Maps JavaScript API no Google Cloud (pode ser a chave do mobile)
# VITE_GOOGLE_MAPS_API_KEY=

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000
# Google Maps (Android — obrigatório para a aba Rota; iOS usa Apple Maps)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Routes (API — rota por estrada; só no servidor apps/api/.env)
# GOOGLE_MAPS_SERVER_API_KEY=
# Ver também GOOGLE_ROUTES_ENABLED e limites em apps/api/.env.example

# Trajeto GPS ao vivo no mapa de rastreio (cada ping WebSocket; não usa Google Routes)
VITE_LIVE_TRACK_WS_POLYLINE_ENABLED=false

# Opção A — Resend (padrão se existir RESEND_API_KEY):

# RESEND_API_KEY=re_sua_chave
# EMAIL_FROM=Pedidos <noreply@dominio-verificado.resend.dev>
# WEB_APP_ORIGIN=https://app.pedixpro.com.br
# WEB_PUBLIC_URL=https://app.pedixpro.com.br
# SITE_PUBLIC_URL=https://pedixpro.com.br
# Opção B — SendGrid:

# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.sua_chave
# EMAIL_FROM=Pedidos <noreply@seudominio.com>
# WEB_APP_ORIGIN=https://app.pedixpro.com.br
